{
  "name": "server-fastify",
  "description": "High-performance Fastify server bootstrap and configuration for the Xeno.js e-commerce example utilizing @xeno-js/fastify.",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "start:api": "tsx src/main.ts",
    "start:worker": "tsx src/main.worker.ts",
    "build": "tsc --project tsconfig.json",
    "db:migrate": "drizzle-kit migrate ",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@ecommerce/core-logic": "file:../core-logic",
    "@xeno-js/fastify": "^2.0.0",
    "dotenv": "^18.0.9"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^11.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5.8.0"
  },
  "keywords": [
    "xeno",
    "xeno-js",
    "server-fastify",
    "fastify",
    "http server",
    "ecommerce backend",
    "high performance",
    "clean architecture",
    "dependency injection",
    "typescript"
  ]
}
